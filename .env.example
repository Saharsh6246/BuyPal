# Copy to .env and fill in. Never commit .env.

# Product discovery (https://trychannel3.com/developers)
CHANNEL3_API_KEY=

# PayPal Sandbox REST app (use a US business sandbox account as the merchant)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI agent: free Groq key, no credit card (https://console.groq.com/keys). Optional.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Buypal stops calling the AI model after this many calls per day.
# LLM_DAILY_LIMIT=600

# Google Shopping via SerpApi (real offers from many US merchants). Optional: https://serpapi.com
SERPAPI_KEY=
# Hard stop for Google Shopping calls per month (keeps the free plan from running out)
# SERPAPI_MONTHLY_LIMIT=200

# Approximate rupees per US dollar for converting INR budgets
# INR_PER_USD=85

# Set to "off" to hide the simulated demo store feed and use only real listings
# DEMO_STORES=on

# PORT=3000
# DB_PATH=data/buypal.db
