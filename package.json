{
  "name": "buypal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Buypal: an AI shopping agent that compares stores, explains every pick, and runs on PayPal",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Saharsh6246/BuyPal.git"
  },
  "homepage": "https://github.com/Saharsh6246/BuyPal#readme",
  "keywords": [
    "paypal",
    "ai-agent",
    "agentic-commerce",
    "shopping"
  ]
}
